# Copy to .env. Paths below are used by Docker Compose; see docs/WEB_DEMO.md for Windows local paths.
MODEL_BUNDLE=./models
WEB_PORT=8000
EXTRACTION_MODE=refined
# Conservative until the combined OCR+Qwen VRAM budget has actually been validated.
GPU_POLICY=exclusive
RESIDENT_VALIDATED=false
RESIDENT_FREE_MIB=7000
MIN_FREE_MIB=512
QUEUE_SIZE=4
PER_SESSION=2
CPU_THREADS=4
MAX_BYTES=15728640
MAX_PIXELS=25000000
DISK_BYTES=2147483648
TTL_SECONDS=86400
STARTUP_TIMEOUT=180
OCR_TIMEOUT=180
EXTRACTION_TIMEOUT=180
JOB_TIMEOUT=600
COOKIE_SECURE=false
BUILD_REVISION=working-tree
